APP_NAME="Adniba Backend"
APP_ENV=production
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ── Database ──────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=adniba_db
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Tuned for high-concurrency: keep-alive + persistent connections
DB_OPTIONS_PDO_MYSQL_ATTR_INIT_COMMAND="SET NAMES utf8mb4 COLLATE utf8mb4_unicode_ci"

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1      # Separate DB for cache keys

# ── Cache ─────────────────────────────────────────────────────────────────────
CACHE_STORE=file
CACHE_PREFIX=adniba_

# ── Queue ─────────────────────────────────────────────────────────────────────
QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database

# Worker settings (used in supervisor config)
QUEUE_EVENTS_WORKERS=4          # Parallel workers for the "events" queue
QUEUE_DEFAULT_WORKERS=2

# ── JWT (admin authentication) ────────────────────────────────────────────────
JWT_SECRET=
JWT_TTL=60              # Token lifetime in minutes
JWT_REFRESH_TTL=20160   # Refresh window (14 days)
JWT_ALGO=HS256
JWT_BLACKLIST_ENABLED=true
JWT_BLACKLIST_GRACE_PERIOD=30

# ── Session (not used for API, but required by framework) ─────────────────────
SESSION_DRIVER=cookie
SESSION_LIFETIME=120

# ── Broadcast / Mail (not used — set to avoid framework warnings) ─────────────
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log
PASSWORD_RESET_URL=https://adniba.vercel.app/reset-password?
