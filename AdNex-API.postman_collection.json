  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string",
      "description": "Login করলে automatically set হবে"
    },
    {
      "key": "api_key",
      "value": "",
      "type": "string",
      "description": "App তৈরি করলে manually set করুন"
    },
