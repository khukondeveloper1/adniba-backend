  "item": [
    {
      "name": "🔐 Admin — Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.access_token) {",
                  "    pm.collectionVariables.set('token', json.access_token);",
                  "    console.log('✅ Token saved:', json.access_token);",
                  "} else {",
                  "    console.log('❌ Login failed');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"changeme123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/admin/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "admin", "auth", "login"]
            },
            "description": "Admin login — token automatically save হবে"
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/auth/refresh",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "admin", "auth", "refresh"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "admin", "auth", "logout"]
            }
          }
        }
      ]
    },
